theme = cyberpunk-neon
font-size = 14
cursor-style = block
cursor-style-blink = true
window-padding-x = 14
window-padding-y = 12
macos-titlebar-style = transparent
background-opacity = 0.50
background-blur-radius = 70
macos-option-as-alt = true

# Split Appearance
split-divider-color = #1e3a5f
unfocused-split-opacity = 0.85

# Split Creation & Management
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface
keybind = super+shift+enter=toggle_split_zoom
keybind = super+ctrl+==equalize_splits

# Split Navigation (Cmd + Shift + Arrow)
keybind = super+shift+arrow_left=goto_split:left
keybind = super+shift+arrow_right=goto_split:right
keybind = super+shift+arrow_up=goto_split:up
keybind = super+shift+arrow_down=goto_split:down

# Split Resizing (Cmd + Ctrl + Arrow)
keybind = super+ctrl+arrow_left=resize_split:left,20
keybind = super+ctrl+arrow_right=resize_split:right,20
keybind = super+ctrl+arrow_up=resize_split:up,20
keybind = super+ctrl+arrow_down=resize_split:down,20
